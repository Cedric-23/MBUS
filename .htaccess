# Block direct access to sensitive folders (Apache)
<IfModule mod_authz_core.c>
    <If "%{REQUEST_URI} =~ m#^/(config|scripts|supabase)/#">
        Require all denied
    </If>
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(config|scripts|supabase)(/|$) - [F,L]
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Same session settings on every page (see Includes/session_boot.php)
<IfModule mod_php.c>
    php_value auto_prepend_file "/var/www/html/Includes/session_boot.php"
</IfModule>
<IfModule mod_php8.c>
    php_value auto_prepend_file "/var/www/html/Includes/session_boot.php"
</IfModule>
