# production = live public site (hides errors, blocks dbtest.php)
MBUS_ENV=local
MBUS_TIMEZONE=Asia/Manila

# Supabase PostgreSQL (required)
# Use Session pooler host from Dashboard → Settings → Database → Connection string
SUPABASE_DB_HOST=aws-1-ap-south-1.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.xeczvnheaixpfattbwsk
SUPABASE_DB_PASSWORD=your_database_password_here

# Supabase API (optional — for future clients)
SUPABASE_URL=https://xeczvnheaixpfattbwsk.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Optional OSRM-compatible driving router. The public OSRM demo is best-effort only;
# configure a managed or self-hosted HTTPS router for sustained production traffic.
MBUS_ROUTING_ENDPOINT=https://router.project-osrm.org

# GCash via PayMongo (leave PAYMONGO_SECRET_KEY empty to keep the manual reference-number form).
# Use test keys (sk_test_...) while developing; they move no real money.
PAYMONGO_SECRET_KEY=
PAYMONGO_WEBHOOK_SECRET=
# Optional: public site URL used for GCash return links (defaults to the current host).
MBUS_BASE_URL=
